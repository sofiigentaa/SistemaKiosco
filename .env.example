# Copiar a .env. Nunca subir las credenciales reales a Git.
DATABASE_URL=postgresql://kiosco:kiosco_local_dev@127.0.0.1:15432/kiosco
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP: necesario para enviar enlaces de recuperación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# "demo" = marca ficticia para demos y videos
VITE_BRAND=""
